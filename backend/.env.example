POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=RDC-NCR-DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
# POSTGRES_SSLMODE=disable
# CONN_MAX_AGE=600

# Email (SMTP)
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@domain.com
# EMAIL_HOST_PASSWORD=your_email_password_or_app_password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=RDC Portal <no-reply@yourdomain.com>

# Frontend URL for setup links
# FRONTEND_BASE_URL=http://localhost:5173

# Password reset request protections
# PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
# PASSWORD_RESET_RATE_LIMIT_EMAIL=2
# PASSWORD_RESET_RATE_LIMIT_IP=5

# Cloudflare Turnstile (optional)
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# TURNSTILE_REQUIRED=false
