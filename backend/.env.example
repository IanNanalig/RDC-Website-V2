# Example environment variables for RDC-NCR Website
# Copy to backend/.env and fill values for your environment (DO NOT commit secrets).

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-service.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
CORS_ALLOW_CREDENTIALS=true

# Database (Supabase/Render Postgres)
# Recommended for Supabase:
DATABASE_URL=
DATABASE_SSL_REQUIRE=true

# Legacy split Postgres variables (local Docker or non-Supabase Postgres)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=
FORCE_SQLITE=0

# Connection pooling
# CONN_MAX_AGE=600

# Production security toggles
# Local development usually keeps SECURE_SSL_REDIRECT=false and secure cookies false.
# Render staging/production should use SECURE_SSL_REDIRECT=true, secure cookies true,
# and SECURE_PROXY_SSL_HEADER=true.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Keep HSTS at 0 for first staging deploy. Enable after the final HTTPS domain is stable.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_PROXY_SSL_HEADER=false

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
CONTACT_RECEIVER_EMAIL=

# Frontend
FRONTEND_BASE_URL=https://your-vercel-app.vercel.app

# CMS media uploads
MEDIA_URL=/media/
MEDIA_ROOT=
CMS_MAX_UPLOAD_BYTES=10485760

# JWT
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# Optional: Sentry DSN
SENTRY_DSN=
