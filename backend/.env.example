# Example environment variables for RDC-NCR Website
# Copy to backend/.env and fill values for your environment (DO NOT commit secrets).

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=
FORCE_SQLITE=0

# Connection pooling
# CONN_MAX_AGE=600

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
CONTACT_RECEIVER_EMAIL=

# Frontend
FRONTEND_BASE_URL=http://localhost:5173

# JWT
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

# Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# Optional: Sentry DSN
SENTRY_DSN=
